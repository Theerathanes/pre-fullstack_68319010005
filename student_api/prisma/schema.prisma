generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  age       Int
  major     String   @db.VarChar(50)
  createdAt DateTime @default(now())
}

model Subject {
  id Int @id @default(autoincrement())
  name String @db.VarChar(67)
  objective String @db.VarChar(50)
  discription String @db.VarChar(100)
  teacher String @db.VarChar(20)
  credit Float 
}